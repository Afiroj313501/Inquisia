# Security (used in upcoming chunks)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional AI/Academic Integrations (used in upcoming chunks)
GEMINI_API_KEY=
